{
  "name": "oss-hawkeye-agent",
  "version": "1.3.0",
  "description": "Context-Aware Security Guardrail for Developers",
  "author": "ryanHwH20",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanHwH20/oss-hawkeye-agent.git"
  },
  "bugs": {
    "url": "https://github.com/ryanHwH20/oss-hawkeye-agent/issues"
  },
  "homepage": "https://github.com/ryanHwH20/oss-hawkeye-agent#readme",
  "files": [
    "dist",
    "adapters",
    "docs/AGENT-HARNESS.md",
    "policy.json",
    "SKILL.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hawkeye": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "uat:pr1": "npm run build && node scripts/uat-pr1.mjs",
    "uat:pr2": "npm run build && node scripts/uat-pr2.mjs",
    "check:setup": "node scripts/check-setup.mjs",
    "check:smoke": "node scripts/smoke.mjs",
    "eval:typosquat": "vitest run test/typosquat-eval.test.ts",
    "test:live": "HAWKEYE_LIVE=1 vitest run test/malware-live.test.ts"
  },
  "keywords": [
    "oss",
    "license",
    "security",
    "compliance"
  ],
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "type": "module",
  "dependencies": {
    "@types/node": "^25.9.1",
    "cvss": "^1.0.5",
    "semver": "^7.8.1",
    "spdx-expression-parse": "^4.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/cvss": "^1.0.3",
    "@types/semver": "^7.7.1",
    "@types/spdx-expression-parse": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}

{
  "name": "oss-hawkeye-agent",
  "version": "1.3.0",
  "description": "Context-Aware Security Guardrail for Developers",
  "author": "ryanHwH20",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanHwH20/oss-hawkeye-agent.git"
  },
  "bugs": {
    "url": "https://github.com/ryanHwH20/oss-hawkeye-agent/issues"
  },
  "homepage": "https://github.com/ryanHwH20/oss-hawkeye-agent#readme",
  "files": [
    "dist",
    "adapters",
    "docs/AGENT-HARNESS.md",
    "docs/INTEGRATIONS.md",
    "docs/UAT-PR5.md",
    "docs/UAT-PR6.md",
    "docs/UAT-PR7.md",
    "policy.json",
    "SKILL.md",
    "skills"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hawkeye": "dist/cli.js",
    "hawkeye-mcp": "adapters/mcp/launcher.mjs"
  },
  "scripts": {
    "build": "tsc && npm run typecheck:vscode && npm run typecheck:mcp",
    "typecheck:vscode": "tsc --noEmit -p adapters/vscode/tsconfig.json",
    "typecheck:mcp": "tsc --noEmit -p adapters/mcp/tsconfig.json",
    "build:vscode": "node adapters/vscode/esbuild.mjs --production",
    "build:mcp": "node adapters/mcp/esbuild.mjs --production",
    "package:vscode": "npm run build && node scripts/package-vscode.mjs",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "uat:pr1": "npm run build && node scripts/uat-pr1.mjs",
    "uat:pr2": "npm run build && node scripts/uat-pr2.mjs",
    "uat:pr3": "npm run build && node scripts/uat-pr3.mjs",
    "uat:pr4": "npm run build && npm run build:vscode && node scripts/uat-pr4.mjs",
    "uat:pr5": "npm run build && npm run build:mcp && node scripts/uat-pr5.mjs",
    "uat:pr6": "npm run build && npm run build:mcp && npm run check:skills && node scripts/uat-pr6.mjs",
    "uat:pr7": "npm run build && npm run build:mcp && npm run check:skills && npm run check:package && node scripts/uat-pr7.mjs",
    "sync:skills": "node scripts/sync-agent-skills.mjs",
    "check:skills": "node scripts/sync-agent-skills.mjs --check",
    "check:package": "node scripts/check-package-contents.mjs",
    "prepack": "npm run check:skills && npm run build && npm run build:mcp",
    "check:setup": "node scripts/check-setup.mjs",
    "check:smoke": "node scripts/smoke.mjs",
    "eval:typosquat": "vitest run test/typosquat-eval.test.ts",
    "test:live": "HAWKEYE_LIVE=1 vitest run test/malware-live.test.ts"
  },
  "keywords": [
    "oss",
    "license",
    "security",
    "compliance"
  ],
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "type": "module",
  "dependencies": {
    "@types/node": "^25.9.1",
    "cvss": "^1.0.5",
    "semver": "^7.8.1",
    "spdx-expression-parse": "^4.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/cvss": "^1.0.3",
    "@types/semver": "^7.7.1",
    "@types/spdx-expression-parse": "^4.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "zod": "4.5.4"
  }
}
